# Replace every placeholder before enabling the related integration.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# CORS Configuration
# Supports comma-separated strings or JSON arrays: e.g. "https://your-domain.com,https://your-project.vercel.app,http://localhost:3000"
CORS_ORIGINS=http://localhost:3000

# Authentication & Security
SECRET_KEY=replace_with_a_random_secret_key

# PostgreSQL Workflow Checkpoint Persistence (LangGraph HITL)
# e.g., postgresql://aegis_user:strong_password@localhost:5432/aegis_checkpoints
POSTGRES_CHECKPOINT_URL=

# GitHub Pull Request Integration
# Requires repo scope permissions to create remediation branches and PRs
GITHUB_TOKEN=replace_with_your_github_personal_access_token
GITHUB_API_URL=https://api.github.com

# Scanner Executable Paths (Optional - defaults to auto-discovery in system PATH)
# ZAP_PATH=/usr/local/bin/zap.sh or C:\Program Files\OWASP\Zed Attack Proxy\zap.bat
# NUCLEI_PATH=/usr/local/bin/nuclei or C:\tools\nuclei.exe
# TRIVY_PATH=/usr/local/bin/trivy or C:\tools\trivy.exe
# NUCLEI_TEMPLATES_DIR=

# Dual-LLM Simulation / Provider Settings
LANGFUSE_PUBLIC_KEY=replace_with_your_langfuse_public_key
LANGFUSE_SECRET_KEY=replace_with_your_langfuse_secret_key
LANGFUSE_ENABLED=false
NEXTAUTH_SECRET=replace_with_a_random_nextauth_secret
SALT=replace_with_a_random_salt
ENCRYPTION_KEY=replace_with_a_64_character_hex_key
LANGFUSE_DB_PASSWORD=replace_with_a_url_safe_random_password
CLICKHOUSE_PASSWORD=replace_with_a_url_safe_random_password
